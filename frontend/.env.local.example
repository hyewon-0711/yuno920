# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API
# Local development: http://localhost:8000
# Production example: https://yuno920-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web Push public key generated with the matching backend VAPID private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Production frontend domain used for Supabase OAuth redirect URLs.
# Confirm the canonical domain before using this in production.
# NEXT_PUBLIC_SITE_URL=https://www.yuno920.com
